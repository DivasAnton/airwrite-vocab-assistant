APP_NAME=AirWrite Vocabulary Assistant
APP_ENV=development
LOG_LEVEL=INFO

CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_MIRROR=true
CAMERA_WINDOW_NAME=AirWrite Camera
SHOW_FPS=true

HAND_LANDMARKER_MODEL_PATH=models/hand_landmarker.task
HAND_NUM_HANDS=1
HAND_MIN_DETECTION_CONFIDENCE=0.5
HAND_MIN_PRESENCE_CONFIDENCE=0.5
HAND_MIN_TRACKING_CONFIDENCE=0.5
DRAW_HAND_LANDMARKS=true
DRAW_HAND_CONNECTIONS=true
DRAW_HANDEDNESS=true

INDEX_FINGER_LANDMARK_INDEX=8
FINGER_SMOOTHING_ALPHA=0.5
DRAW_RAW_FINGER_POINT=false
DRAW_SMOOTHED_FINGER_POINT=true
FINGER_POINT_RADIUS=8

CANVAS_BACKGROUND_COLOR=0,0,0
CANVAS_STROKE_COLOR=255,255,255
CANVAS_STROKE_THICKNESS=8
CANVAS_MAX_POINT_DISTANCE=120
CANVAS_OVERLAY_OPACITY=1.0
SHOW_CAMERA_WITH_CANVAS=true
SHOW_CANVAS_WINDOW=true
CANVAS_CLEAR_KEY=c

GESTURE_STABLE_FRAMES=5
GESTURE_COOLDOWN_MS=500
GESTURE_LOST_HAND_FRAMES=10
ENABLE_GESTURE_CONTROL=true
ENABLE_KEYBOARD_FALLBACK=true
DRAW_GESTURE_LABEL=true
DRAW_STATE_LABEL=true
CLEAR_HOLD_MS=1500
ENABLE_CLEAR_GESTURE=false
FINGER_EXTENSION_MARGIN=0.02

DRAWING_OUTPUT_DIR=data/drawings
DRAWING_IMAGE_FORMAT=png
DRAWING_FILENAME_PREFIX=drawing
AUTO_SAVE_ON_DONE=true
ENABLE_MANUAL_SAVE=true
MANUAL_SAVE_KEY=s
CLEAR_CANVAS_AFTER_SAVE=false
SHOW_SAVE_STATUS=true
SAVE_STATUS_DISPLAY_MS=2000

# Shared model-input contract
MODEL_INPUT_WIDTH=28
MODEL_INPUT_HEIGHT=28
MODEL_INPUT_CHANNELS=1
MODEL_INPUT_BACKGROUND_VALUE=0
MODEL_INPUT_NORMALIZATION_DIVISOR=255.0

# EMNIST preprocessing audit
EMNIST_DATA_DIR=data/external/emnist
EMNIST_DATASET_NAME=emnist/letters
EMNIST_TRANSPOSE_IMAGES=true
EMNIST_PRESERVE_GRAYSCALE=true

# AirWrite source adaptation
AIRWRITE_BINARY_THRESHOLD=20
AIRWRITE_CROP_PADDING=8
AIRWRITE_CONTENT_WIDTH=20
AIRWRITE_CONTENT_HEIGHT=20
AIRWRITE_MIN_FOREGROUND_PIXELS=10
AIRWRITE_INVERT_INPUT=false
AIRWRITE_CENTER_OF_MASS=false

# Cross-domain preprocessing audit
PREPROCESS_AUDIT_SAMPLES_PER_CLASS=10
PREPROCESS_AUDIT_OUTPUT_DIR=artifacts/preprocessing_audit
SAVE_PREPROCESS_AUDIT_IMAGES=false

# Sprint 9E official EMNIST Letters identity training
EMNIST_SOURCE=official_idx
EMNIST_OFFICIAL_DATA_DIR=data/external/emnist/gzip
EMNIST_TRAIN_IMAGES_FILE=emnist-letters-train-images-idx3-ubyte.gz
EMNIST_TRAIN_LABELS_FILE=emnist-letters-train-labels-idx1-ubyte.gz
EMNIST_TEST_IMAGES_FILE=emnist-letters-test-images-idx3-ubyte.gz
EMNIST_TEST_LABELS_FILE=emnist-letters-test-labels-idx1-ubyte.gz
EMNIST_RAW_LABEL_MIN=1
EMNIST_RAW_LABEL_MAX=26
EMNIST_ARTIFACT_ROOT=artifacts/emnist_letters_identity/v1
EMNIST_ARTIFACT_VERSION=v1
EMNIST_MODEL_PATH=artifacts/emnist_letters_identity/v1/model.keras
EMNIST_BEST_MODEL_PATH=artifacts/emnist_letters_identity/v1/checkpoints/best.keras
EMNIST_HISTORY_PATH=artifacts/emnist_letters_identity/v1/training_history.csv
AIRWRITE_IDENTITY_EVAL_MANIFEST=data/airwrite_identity_eval/manifest.csv
EMNIST_VALIDATION_RATIO=0.10
EMNIST_RANDOM_SEED=42
EMNIST_BATCH_SIZE=128
EMNIST_SHUFFLE_BUFFER=20000
EMNIST_CACHE_DATASET=false
EMNIST_PREFETCH_DATASET=true
EMNIST_MAX_EPOCHS=50
EMNIST_LEARNING_RATE=0.001
EMNIST_EARLY_STOPPING_PATIENCE=5
EMNIST_REDUCE_LR_PATIENCE=3
EMNIST_DROPOUT_RATE=0.30
EMNIST_ROTATION_FACTOR=0.03
EMNIST_TRANSLATION_FACTOR=0.08
EMNIST_ZOOM_FACTOR=0.08
EMNIST_MODEL_VERSION=1.0.0

SAVE_PREPROCESS_DEBUG_IMAGES=false
PREPROCESS_DEBUG_OUTPUT_DIR=data/preprocessed_debug
MANUAL_PREPROCESS_KEY=p
ENABLE_DATASET_CAPTURE=true
DATASET_CAPTURE_OUTPUT_DIR=data/raw_airwrite
DATASET_CAPTURE_IMAGE_FORMAT=png
DATASET_CAPTURE_FILENAME_PREFIX=airwrite
DATASET_CAPTURE_WRITING_STYLE=uppercase
DATASET_CAPTURE_INITIAL_LABEL=A
DATASET_CAPTURE_SAVE_KEY=v
DATASET_CAPTURE_NEXT_LABEL_KEY=]
DATASET_CAPTURE_PREVIOUS_LABEL_KEY=[
DATASET_CAPTURE_CLEAR_AFTER_SAVE=false

# EMNIST identity model
IDENTITY_MODEL_PATH=artifacts/emnist_letters_identity/v1/model.keras
IDENTITY_LABELS_PATH=artifacts/emnist_letters_identity/v1/identity_labels.json
LOWERCASE_DISPLAY_LABELS_PATH=artifacts/emnist_letters_identity/v1/lowercase_display_labels.json
UPPERCASE_DISPLAY_LABELS_PATH=artifacts/emnist_letters_identity/v1/uppercase_display_labels.json
IDENTITY_MODEL_METADATA_PATH=artifacts/emnist_letters_identity/v1/model_metadata.json
IDENTITY_PREPROCESSING_CONFIG_PATH=artifacts/emnist_letters_identity/v1/preprocessing_config.json

# Case control
DEFAULT_CHARACTER_CASE_MODE=lowercase
LOWERCASE_MODE_KEY=l
UPPERCASE_MODE_KEY=u
SHIFT_NEXT_KEY=y
CANCEL_SHIFT_KEY=z
ENABLE_AUTO_CASE_MODE=false
SHOW_CHARACTER_CASE_MODE=true
SHOW_CASE_INFERENCE_DEBUG=false
CASE_STATUS_DISPLAY_MS=3000

# Prediction
PREDICTION_TOP_K=3
PREDICTION_MIN_CONFIDENCE=0.60
PREDICTION_MIN_MARGIN=0.15
ENABLE_AUTO_PREDICT_ON_DONE=true
ENABLE_MANUAL_PREDICT=true
MANUAL_PREDICT_KEY=i
SHOW_PREDICTION_STATUS=true
SHOW_TOP_K_PREDICTIONS=true
PREDICTION_STATUS_DISPLAY_MS=4000
LOG_PREDICTION_LATENCY=true
PREDICTION_LATENCY_WARNING_MS=500

WORD_MAX_LENGTH=30
WORD_CANONICALIZATION=casefold
WORD_AUTO_APPEND_ACCEPTED=true
WORD_REQUIRE_SELECTION_FOR_UNCERTAIN=true
WORD_SELECT_CANDIDATE_1_KEY=1
WORD_SELECT_CANDIDATE_2_KEY=2
WORD_SELECT_CANDIDATE_3_KEY=3
WORD_CANCEL_PENDING_KEY=x
WORD_BACKSPACE_KEY=b
WORD_CLEAR_KEY=k
WORD_CONFIRM_KEY=enter
WORD_NEW_KEY=n
AUTO_CLEAR_CANVAS_AFTER_CHARACTER=true
AUTO_CLEAR_CANVAS_AFTER_PENDING_CANCEL=true
SHOW_WORD_BUILDER=true
SHOW_PENDING_CANDIDATES=true
WORD_STATUS_DISPLAY_MS=3000

# Whole-word AirWriting input mode
DEFAULT_DRAWING_INPUT_MODE=character
CHARACTER_MODE_KEY=r
WORD_MODE_KEY=w

# Whole-word writing ROI
WORD_ROI_X_RATIO=0.05
WORD_ROI_Y_RATIO=0.20
WORD_ROI_WIDTH_RATIO=0.90
WORD_ROI_HEIGHT_RATIO=0.60

# Whole-word limits
WHOLE_WORD_MIN_CHARACTERS=2
WHOLE_WORD_MAX_CHARACTERS=12
WHOLE_WORD_MAX_STROKES=64
WHOLE_WORD_MAX_POINTS_PER_STROKE=1000

# Whole-word segmentation
WORD_SEGMENT_MIN_FOREGROUND_PIXELS=10
WORD_SEGMENT_MIN_COMPONENT_AREA=4
WORD_SEGMENT_MIN_SEPARATOR_GAP=10
WORD_SEGMENT_MAX_INTERNAL_GAP=16
WORD_SEGMENT_X_OVERLAP_THRESHOLD=0.25
WORD_SEGMENT_TINY_COMPONENT_RATIO=0.20
WORD_SEGMENT_WIDE_GROUP_RATIO=1.80

# Whole-word prediction
WHOLE_WORD_TOP_K=3
WHOLE_WORD_MIN_CONFIDENCE=0.60
WHOLE_WORD_MIN_MARGIN=0.15

# Whole-word case policy
DEFAULT_WORD_CASE_POLICY=lowercase
WORD_CASE_LOWERCASE_KEY=l
WORD_CASE_UPPERCASE_KEY=u
WORD_CASE_CAPITALIZE_KEY=p
WORD_CASE_CUSTOM_KEY=o

# Whole-word draft controls
WORD_PREVIOUS_POSITION_KEY=[
WORD_NEXT_POSITION_KEY=]
WORD_TOGGLE_SELECTED_CASE_KEY=g
WORD_SPLIT_SELECTED_SEGMENT_KEY=s
WORD_MERGE_SELECTED_WITH_NEXT_KEY=v
WORD_ACCEPT_DRAFT_KEY=a
WORD_CANCEL_DRAFT_KEY=x

# Whole-word audit and UI
WORD_SEGMENT_AUDIT_DIR=artifacts/word_segmentation_audit
SAVE_WORD_SEGMENT_AUDIT_IMAGES=false
SHOW_WORD_ROI=true
SHOW_WORD_SEGMENT_BOXES=true
SHOW_WORD_SEGMENT_CONFIDENCE=false
SHOW_WORD_PREDICTION_CONFIDENCE=true

DATASET_ROOT=data/raw_airwrite
DATASET_MANIFEST_PATH=data/manifests/dataset_manifest.csv
DATASET_SPLITS_PATH=data/manifests/dataset_splits.csv

TRAIN_RATIO=0.70
VALIDATION_RATIO=0.15
TEST_RATIO=0.15
TRAINING_RANDOM_SEED=42
DATASET_IMAGES_PREPROCESSED=true

MODEL_NUM_CLASSES=26

TRAIN_BATCH_SIZE=64
TRAIN_MAX_EPOCHS=50
TRAIN_LEARNING_RATE=0.001
TRAIN_EARLY_STOPPING_PATIENCE=5

TRAIN_ENABLE_AUGMENTATION=true
TRAIN_ROTATION_FACTOR=0.03
TRAIN_TRANSLATION_FACTOR=0.08
TRAIN_ZOOM_FACTOR=0.08

MODEL_OUTPUT_PATH=artifacts/models/character_recognizer.keras
LABELS_OUTPUT_PATH=artifacts/labels/labels.json
METRICS_OUTPUT_PATH=artifacts/metadata/metrics.json
MODEL_METADATA_PATH=artifacts/metadata/model_metadata.json
PREPROCESSING_CONFIG_OUTPUT_PATH=artifacts/metadata/preprocessing_config.json
TRAINING_HISTORY_PATH=artifacts/reports/training_history.csv
CLASSIFICATION_REPORT_PATH=artifacts/reports/classification_report.json
CONFUSION_MATRIX_JSON_PATH=artifacts/reports/confusion_matrix.json
CONFUSION_MATRIX_IMAGE_PATH=artifacts/reports/confusion_matrix.png
ERROR_ANALYSIS_PATH=artifacts/reports/error_analysis.csv
PREDICTION_PROBABILITIES_PATH=artifacts/reports/prediction_probabilities.csv
EXPERIMENT_LOG_PATH=artifacts/reports/experiments.csv
BASELINE_METRICS_PATH=artifacts/metadata/baseline_metrics.json

MODEL_NAME=airwrite_character_recognizer
MODEL_VERSION=0.1.0
TRAIN_EXPERIMENT_ID=exp_custom_001
TRAIN_EXPERIMENT_NOTES=Custom AirWrite uppercase A-Z

MODEL_PATH=models/character_cnn.pth
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SAVED_DRAWINGS_DIR=data/saved_drawings
